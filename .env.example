# Copy to .env and fill in. Never commit .env.

# Postgres password for the app database
DB_PASSWORD=change-me

# OSM API target at first start: dev (default) or prod. Switching later happens in Settings.
OSM_TARGET=dev

# OAuth 2.0 apps. Register one per target (redirect URI http://localhost:3000/auth/callback,
# scopes read_prefs write_api):
#   dev:  https://master.apis.dev.openstreetmap.org/oauth2/applications
#   prod: https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID_DEV=
OSM_CLIENT_SECRET_DEV=
OSM_CLIENT_ID_PROD=
OSM_CLIENT_SECRET_PROD=

# Encrypts stored OAuth tokens. Generate with: openssl rand -base64 32
# Without it, tokens are kept in memory only and lost on restart.
TOKEN_ENCRYPTION_KEY=

# Bearer token for the MCP endpoint (http://localhost:3000/mcp). Generated and shown in Settings if empty.
MCP_TOKEN=

# Optional
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# DEFAULT_AREAS=/data/areas.geojson   # GeoJSON FeatureCollection; features' properties.name become presets
# EXTRACT_URL=https://download.geofabrik.de/europe/czech-republic-latest.osm.pbf
# CONTACT=you@example.com             # goes into the User-Agent sent to the OSM API
